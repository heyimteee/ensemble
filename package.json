{
  "name": "ensemble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent agent teams inside OpenCode",
  "exports": {
    ".": "./src/v2/server.ts",
    "./tui": "./src/v2/tui/index.tsx",
    "./rpc": "./src/v2/rpc.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test",
    "doctor": "node --experimental-strip-types src/v2/doctor-cli.ts",
    "test": "node --test --experimental-strip-types src/v2/*.test.ts src/v2/tui/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types src/v2/*.test.ts src/v2/tui/*.test.ts",
    "test:live": "bash scripts/live-check.sh",
    "test:live:fake": "bash scripts/live-check-fake.sh",
    "test:live:fake:empty": "bash scripts/live-check-fake-empty.sh",
    "test:live:preflight": "bash scripts/live-preflight.sh",
    "test:live:fake:all": "bash scripts/live-matrix.sh fake",
    "test:live:all": "bash scripts/live-matrix.sh all",
    "test:live:latency": "bash scripts/live-latency-probe.sh",
    "test:live:sizes": "bash scripts/live-size-matrix.sh",
    "test:live:lifecycle": "bash scripts/live-lifecycle-fake.sh",
    "test:live:subagent": "bash scripts/live-subagent-probe.sh",
    "test:live:multilocation": "bash scripts/live-multilocation.sh",
    "issue:hygiene": "node scripts/issue-hygiene.mjs",
    "logs:summary": "node scripts/log-summary.mjs",
    "worktree:create": "bash scripts/worktree-create.sh",
    "integration:merge": "bash scripts/integration-merge.sh"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.1",
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.1",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "26.6.6",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  }
}
