{
  "name": "@heyimteee/ensemble",
  "version": "0.1.0-rc.2",
  "description": "Persistent agent teams inside OpenCode",
  "license": "MIT",
  "author": "heyimteee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyimteee/ensemble.git"
  },
  "homepage": "https://github.com/heyimteee/ensemble#readme",
  "bugs": {
    "url": "https://github.com/heyimteee/ensemble/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agents",
    "agent-teams",
    "multi-agent",
    "tui",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./dist/server.js",
    "./tui": "./dist/tui/index.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "tsc -p tsconfig.build.json && node scripts/check-build.mjs",
    "prepack": "npm run build && npm run check:build",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test",
    "doctor": "node --experimental-strip-types src/v2/doctor-cli.ts",
    "test": "node --test --experimental-strip-types src/v2/*.test.ts src/v2/tui/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types src/v2/*.test.ts src/v2/tui/*.test.ts",
    "test:live": "bash scripts/live-check.sh",
    "test:live:fake": "bash scripts/live-check-fake.sh",
    "test:live:fake:empty": "bash scripts/live-check-fake-empty.sh",
    "test:live:preflight": "bash scripts/live-preflight.sh",
    "test:live:fake:all": "bash scripts/live-matrix.sh fake",
    "test:live:all": "bash scripts/live-matrix.sh all",
    "test:live:latency": "bash scripts/live-latency-probe.sh",
    "test:live:latency:reference": "ENSEMBLE_LATENCY_PROFILE=reference bash scripts/live-latency-probe.sh",
    "latency:budget": "node --experimental-strip-types scripts/latency-budget.mjs",
    "test:live:sizes": "bash scripts/live-size-matrix.sh",
    "test:live:lifecycle": "bash scripts/live-lifecycle-fake.sh",
    "test:live:subagent": "bash scripts/live-subagent-probe.sh",
    "test:live:probe": "bash scripts/live-host-probe.sh",
    "test:live:native-first": "bash scripts/live-native-first.sh",
    "test:live:vera": "bash scripts/live-vera-regression.sh",
    "benchmark:tools": "node --experimental-strip-types scripts/tool-surface-benchmark.mjs",
    "benchmark:synthesis": "node --experimental-strip-types scripts/synthesis-benchmark.mjs",
    "test:live:tool-surface": "bash scripts/live-tool-surface-benchmark.sh",
    "test:live:multilocation": "bash scripts/live-multilocation.sh",
    "soak": "bash scripts/soak-fake.sh",
    "soak:smoke": "bash scripts/soak-fake.sh --smoke",
    "support:bundle": "node --experimental-strip-types scripts/support-bundle.mjs",
    "issue:hygiene": "node scripts/issue-hygiene.mjs",
    "logs:summary": "node scripts/log-summary.mjs",
    "docs:check": "node --experimental-strip-types scripts/docs-check.mjs",
    "backup": "node scripts/backup.mjs",
    "test:install:rc": "bash scripts/live-install-check.sh",
    "data": "node --experimental-strip-types src/v2/data-cli.ts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.6 || 2.2.7 || 2.3.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/plugin": "2.2.1",
    "@types/node": "26.6.6",
    "babel-preset-solid": "1.9.12",
    "typescript": "7.0.2"
  }
}
